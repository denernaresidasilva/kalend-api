"""PROPOSAL: inspection only; activation deliberately unavailable until all release gates pass."""
import json
import os
import pwd
import subprocess
import sys
import stat

def trusted_file(path, error):
    # Reject symlinks and writable/untrusted ancestors, not just the final inode.
    absolute = os.path.abspath(path)
    if absolute != path:
        sys.exit(error)
    parts = [''] + absolute.split('/')[1:]
    current = '/'
    for index, part in enumerate(parts):
        current = os.path.join(current, part)
        try:
            info = os.lstat(current)
            # Reject every POSIX ACL (including default ACL) and file capability.
            # Listing errors/unsupported filesystems fail closed; no external tool.
            attrs = os.listxattr(current, follow_symlinks=False)
        except OSError:
            sys.exit(error)
        if any(a in ('system.posix_acl_access', 'system.posix_acl_default',
                     'security.capability') or 'acl' in a.lower() for a in attrs):
            sys.exit(error)
        final = index == len(parts) - 1
        if (info.st_uid != 0 or info.st_mode & 0o022 or stat.S_ISLNK(info.st_mode)
            or (final and not stat.S_ISREG(info.st_mode))
            or (not final and not stat.S_ISDIR(info.st_mode))):
            sys.exit(error)


contexts = {
    'kalend-dev': ('/home/kalend-dev/htdocs/dev.kalend.tech/app', 3002),
    'kalend-api-dev': ('/home/kalend-api-dev/htdocs/api-dev.kalend.tech/app', 3003),
}
