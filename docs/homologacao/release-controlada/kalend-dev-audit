#!/usr/bin/python3 -I
"""PROPOSAL: root-owned forced command; no caller-supplied SQL/connection/path."""
import os
import pwd
import sys
import stat

def trusted_file(path, error):
    # Reject symlinks and writable/untrusted ancestors, not just the final inode.
    absolute = os.path.abspath(path)
    if absolute != path:
        sys.exit(error)
    parts = [''] + absolute.split('/')[1:]
    current = '/'
    for index, part in enumerate(parts):
        current = os.path.join(current, part)
        try:
            info = os.lstat(current)
            # Reject every POSIX ACL (including default ACL) and file capability.
            # Listing errors/unsupported filesystems fail closed; no external tool.
            attrs = os.listxattr(current, follow_symlinks=False)
        except OSError:
            sys.exit(error)
        if any(a in ('system.posix_acl_access', 'system.posix_acl_default',
                     'security.capability') or 'acl' in a.lower() for a in attrs):
            sys.exit(error)
        final = index == len(parts) - 1
        if (info.st_uid != 0 or info.st_mode & 0o022 or stat.S_ISLNK(info.st_mode)
            or (final and not stat.S_ISREG(info.st_mode))
            or (not final and not stat.S_ISDIR(info.st_mode))):
            sys.exit(error)


if pwd.getpwuid(os.getuid()).pw_name != 'kalend_dev_audit':
    sys.exit('AUDIT_IDENTITY_REQUIRED')
if os.environ.get('SSH_ORIGINAL_COMMAND') != 'backfill-audit':
    sys.exit('COMMAND_NOT_ALLOWED')
# This SQL must be administrator-owned, immutable to the audit and application users.
sql = '/usr/local/share/kalend-dev-audit/backfill-audit.sql'
for path in [__file__, sql]:
    trusted_file(path, 'UNSAFE_AUDIT_FILE')
os.execve('/usr/lib/postgresql/16/bin/psql', ['psql', '-X', '-q', '-A', '-t', '-w', '-v', 'ON_ERROR_STOP=1',
    '-h', '/var/run/postgresql', '-U', 'kalend_dev_audit', '-d', 'kalend_dev',
    '-c', 'BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY', '-f', sql, '-c', 'COMMIT'],
    {'PATH': '/usr/bin:/bin', 'PGAPPNAME': 'kalend-dev-backfill-audit',
     'PGOPTIONS': '-c default_transaction_read_only=on -c statement_timeout=30000 -c lock_timeout=3000 -c idle_in_transaction_session_timeout=15000 -c search_path=pg_catalog,public -c row_security=off'})
