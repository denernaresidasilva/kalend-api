  entitlementId  String? @db.Uuid
  entitlement    SubscriptionEntitlement? @relation(fields: [entitlementId], references: [id], onDelete: Restrict)
  startsAt       DateTime?
  endsAt         DateTime?
  status         PaymentEvidenceStatus @default(APPLIED)
  reviewReason   String?
  financialReviewRequired Boolean @default(false)
  revokedAt      DateTime?
  createdAt      DateTime @default(now())

  @@index([subscriptionId, status, startsAt, endsAt])
  @@index([companyId])
  @@index([entitlementId])
}
