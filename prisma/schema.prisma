generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  RECEPTIONIST
  PROFESSIONAL
  CLIENT
  ACCOUNTANT
}

enum BookingRequestStatus {
  REQUESTED
  CONFIRMED
  REJECTED
  CANCELLED
  EXPIRED
}

enum CompanyAdministrativeStatus {
  ACTIVE
  DISABLED
  LEGACY_UNKNOWN
}

enum CompanyStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELED
}

enum SubscriptionStatus {
  PENDING
  SUSPENDED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  OVERDUE
  PENDING
  APPROVED
  FAILED
  REFUNDED
  CANCELED
}

enum PaymentGateway {
  MANUAL
  MERCADO_PAGO
  STRIPE
  PAGBANK
  ASAAS
  QA_SIMULATION
}

enum PaymentCreationState {
  READY
  CREATING
  CREATED
  UNCERTAIN
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  // A SQL expression index also enforces lower(btrim(email)) for every writer.
  email        String  @unique
  passwordHash String
  name         String
  phone        String?
  isActive     Boolean @default(true)
  isSuperAdmin Boolean @default(false)

  entitlementGrants       SubscriptionEntitlement[] @relation("EntitlementGrantActor")
  entitlementRevocations  SubscriptionEntitlement[] @relation("EntitlementRevokeActor")
  memberships             Membership[]
  authSessions            AuthSession[]
  notifications           Notification[]
  notificationPreference  NotificationPreference?
  globalPushSubscriptions GlobalPushSubscription[]
  customerProfiles        CustomerProfile[]
  customerActivations     CustomerActivation[]
  publicSignupConsents    PublicSignupConsent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
 confirmationSettings BookingConfirmationSettings?
 waitlistSettings WaitlistSettings?
 waitlistEntries WaitlistEntry[]
 loyaltySettings PosLoyaltySettings?
 loyaltyCards PosLoyaltyCard[]
  posCashSessions PosCashSession[]
  posProducts PosProduct[]
  posCoupons PosCoupon[]
  posSales PosSale[]
  evolutionConnection EvolutionConnection?
  emailConfiguration  CompanyEmailConfiguration?
  notifications       Notification[]
  id                  String                     @id @default(uuid()) @db.Uuid
  name                String
  slug                String                     @unique
  status              CompanyStatus              @default(TRIAL)
  administrativeStatus CompanyAdministrativeStatus @default(ACTIVE)
  timezone            String                     @default("America/Sao_Paulo")
  isActive            Boolean                    @default(true)

  memberships            Membership[]
  subscriptions          Subscription[]
  payments               Payment[]
  paymentEvidence        PaymentEvidence[]
  webhookEvents          WebhookEvent[]
  authSessions           AuthSession[]
  communicationTemplates CompanyCommunicationTemplate[]
  publicSignupConsents   PublicSignupConsent[]
  services               Service[]
  professionalProfiles   ProfessionalProfile[]
  customerProfiles      CustomerProfile[]
  bookingRequests       BookingRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  companyId String         @db.Uuid
  role      MembershipRole
  isActive  Boolean        @default(true)

  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company            Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pushAuthorizations GlobalPushAuthorization[]
  professionalProfile ProfessionalProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyId])
  @@unique([id, companyId])
  @@index([companyId, role])
  @@index([userId])
}

// Tenant-owned operational catalog. Every business record carries companyId;
// composite foreign keys below prevent cross-company references at the DB layer.
model Service {
 depositPolicies BookingDepositPolicy[]
 waitlistEntries WaitlistEntry[]
  followupRules PosServiceFollowup[]
  commissionRules PosCommissionRule[]
  posLines PosSaleLine[]
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  name            String
  description     String?
  category        String?
  durationMinutes Int
  priceCents      Int
  active          Boolean  @default(true)
  public          Boolean  @default(true)
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  professionalLinks ServiceProfessional[]
  bookingItems    BookingRequestItem[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([id, companyId])
  @@index([companyId, active, public, category])
}

model ProfessionalProfile {
 depositPolicies BookingDepositPolicy[]
 waitlistEntries WaitlistEntry[]
 waitlistOpportunities WaitlistOpportunity[]
  commissionRules PosCommissionRule[]
  commissions PosCommission[]
  posLines PosSaleLine[]
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  membershipId String   @db.Uuid
  displayName  String
  active       Boolean  @default(true)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId, companyId], references: [id, companyId], onDelete: Cascade)
  availability ProfessionalAvailability[]
  services     ServiceProfessional[]
  bookingItems BookingRequestItem[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([id, companyId])
  @@unique([membershipId, companyId])
  @@index([companyId, active])
}

model ProfessionalAvailability {
  id             String @id @default(uuid()) @db.Uuid
  companyId      String @db.Uuid
  professionalId String @db.Uuid
  weekday        Int
  startMinute    Int
  endMinute      Int
  active         Boolean @default(true)
  professional   ProfessionalProfile @relation(fields: [professionalId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([companyId, professionalId, weekday, active])
}

model ServiceProfessional {
  companyId      String @db.Uuid
  serviceId      String @db.Uuid
  professionalId String @db.Uuid
  service        Service @relation(fields: [serviceId, companyId], references: [id, companyId], onDelete: Cascade)
  professional   ProfessionalProfile @relation(fields: [professionalId, companyId], references: [id, companyId], onDelete: Cascade)

  @@id([serviceId, professionalId])
  @@index([companyId, professionalId])
}

model CustomerProfile {
 waitlistEntries WaitlistEntry[]
 loyaltyCard PosLoyaltyCard?
  messageConsents PosMessageConsent[]
  followupJobs PosFollowupJob[]
  posSales PosSale[]
  userId      String? @db.Uuid
  user        User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  activation  CustomerActivation?
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  name        String
  email       String?
  phone       String?
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requests    BookingRequest[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([id, companyId])
  @@unique([companyId, userId])
  @@unique([companyId, email])
  @@unique([companyId, phone])
  @@index([companyId, phone])
}

model CustomerActivation {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  customerId String @db.Uuid
  customer CustomerProfile @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdById String @db.Uuid
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@unique([customerId, companyId])
  @@index([expiresAt])
}

model BookingRequest {
 scheduleChanges BookingScheduleChange[]
 confirmation BookingConfirmation?
 waitlistOpportunity WaitlistOpportunity?
  posSale PosSale?
  id             String @id @default(uuid()) @db.Uuid
  companyId      String @db.Uuid
  customerId     String @db.Uuid
  status         BookingRequestStatus @default(REQUESTED)
  idempotencyKey String
  holdExpiresAt  DateTime
  termsAcceptedAt DateTime @default(now())
  termsVersion String
  privacyVersion String
  marketingOptIn Boolean @default(false)
  marketingConsentedAt DateTime?
  customer       CustomerProfile @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  company        Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items          BookingRequestItem[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, idempotencyKey])
  @@unique([id, companyId])
  @@index([companyId, status, createdAt])
  @@index([status, holdExpiresAt])
}

model BookingRequestItem {
  posLines PosSaleLine[]
  id             String @id @default(uuid()) @db.Uuid
  companyId      String @db.Uuid
  requestId      String @db.Uuid
  serviceId      String @db.Uuid
  professionalId String @db.Uuid
  serviceName    String
  priceCents     Int
  durationMinutes Int
  startsAt       DateTime
  endsAt         DateTime
  request        BookingRequest @relation(fields: [requestId, companyId], references: [id, companyId], onDelete: Cascade)
  service        Service @relation(fields: [serviceId, companyId], references: [id, companyId], onDelete: Restrict)
  professional   ProfessionalProfile @relation(fields: [professionalId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, professionalId, startsAt, endsAt])
  @@unique([id, companyId])
  @@index([companyId, requestId])
}

model PublicSignupConsent {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @db.Uuid
  companyId             String   @db.Uuid
  termsVersion          String
  privacyVersion        String
  acceptedAt            DateTime @default(now())
  marketingOptIn         Boolean  @default(false)
  marketingConsentedAt   DateTime?
  attribution             Json?
  source                 String   @default("PUBLIC_LP")
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company                Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId, acceptedAt])
}

model Plan {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  code        String  @unique
  description String?

  monthlyPriceCents Int
  yearlyPriceCents  Int?

  trialEnabled Boolean @default(true)
  trialDays    Int     @default(7)

  badge        String?
  isFeatured   Boolean @default(false)
  displayOrder Int     @default(0)

  maxProfessionals Int?
  maxClients       Int?
  maxUnits         Int? @default(1)

  isActive    Boolean @default(true)
  isPublic    Boolean @default(true)
  maxMessages Int?

  features      PlanFeature[]
  subscriptions Subscription[]
  payments      Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
}

model PlanFeature {
  id     String @id @default(uuid()) @db.Uuid
  planId String @db.Uuid

  code String
  name String

  enabled Boolean @default(true)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, code])
  @@index([planId])
}

model Subscription {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  planId    String @db.Uuid

  status          SubscriptionStatus @default(TRIALING)
  billingInterval BillingInterval    @default(MONTHLY)

  trialStartedAt DateTime?
  trialEndsAt    DateTime?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  canceledAt DateTime?
  endedAt    DateTime?

  gateway PaymentGateway @default(MANUAL)

  environment             GatewayEnvironment?
  expectedAmountCents     Int?
  currency                String              @default("BRL")
  graceEndsAt             DateTime?
  cancelAtPeriodEnd       Boolean             @default(false)
  cancellationRequestedAt DateTime?
  externalSubscriptionId  String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])

  entitlements SubscriptionEntitlement[]
  paymentEvidence PaymentEvidence[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gateway, environment, externalSubscriptionId])
  @@index([companyId])
  @@index([planId])
  @@index([status])
  @@index([externalSubscriptionId])
}

model Payment {
  id             String  @id @default(uuid()) @db.Uuid
  companyId      String  @db.Uuid
  subscriptionId String? @db.Uuid

  billingInterval     BillingInterval      @default(MONTHLY)
  externalCheckoutId  String?
  checkoutUrl         String?
  creationState       PaymentCreationState @default(READY)
  creationStartedAt   DateTime?
  recurring           Boolean              @default(false)
  refundedAmountCents Int                  @default(0)
  amountCents         Int
  status              PaymentStatus
  gateway             PaymentGateway

  planId            String?             @db.Uuid
  plan              Plan?               @relation(fields: [planId], references: [id])
  environment       GatewayEnvironment?
  idempotencyKey    String?             @unique
  currency          String              @default("BRL")
  periodStart       DateTime?
  periodEnd         DateTime?
  paymentEvidence   PaymentEvidence?
  webhookEvents     WebhookEvent[]
  externalPaymentId String?
  description       String?

  paidAt     DateTime?
  refundedAt DateTime?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gateway, environment, externalPaymentId])
  @@index([companyId])
  @@index([subscriptionId])
  @@index([status])
  @@index([gateway])
  @@index([externalPaymentId])
}

model WebhookEvent {
  id String @id @default(uuid()) @db.Uuid

  gateway PaymentGateway

  externalEventId String
  eventType       String?

  companyId   String?             @db.Uuid
  paymentId   String?             @db.Uuid
  company     Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  payment     Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  environment GatewayEnvironment?
  attempts    Int                 @default(0)
  payload     Json

  status       WebhookStatus @default(RECEIVED)
  errorMessage String?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gateway, environment, externalEventId])
  @@index([gateway])
  @@index([status])
  @@index([receivedAt])
}

enum GatewayEnvironment {
  SANDBOX
  PRODUCTION
}

enum IntegrationStatus {
  NOT_CONFIGURED
  PENDING_VALIDATION
  CONNECTED
  FAILED
}

model GatewayConfiguration {
  gateway                       PaymentGateway     @id
  enabled                       Boolean            @default(false)
  environment                   GatewayEnvironment @default(SANDBOX)
  publicId                      String?
  credentialsEncrypted          String?
  recurringCredentialsEncrypted String?
  recurringEnabled              Boolean            @default(false)
  webhookSecretEncrypted        String?
  status                        IntegrationStatus  @default(NOT_CONFIGURED)
  lastValidatedAt               DateTime?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
}

model AuthSession {
  credentialHash    String             @db.Char(64)
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @db.Uuid
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedCompanyId String?            @db.Uuid
  selectedCompany   Company?           @relation(fields: [selectedCompanyId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  lastUsedAt        DateTime           @default(now())
  expiresAt         DateTime
  refreshExpiresAt  DateTime
  revokedAt         DateTime?
  refreshTokens     AuthRefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuthRefreshToken {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @db.Uuid
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash String      @unique @db.Char(64)
  createdAt DateTime    @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([sessionId])
  @@index([expiresAt])
}

model AuthRateLimit {
  key       String   @id @db.Char(64)
  attempts  Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

enum CommunicationScope {
  GLOBAL
  COMPANY
}

enum CommunicationChannel {
  EMAIL
  WHATSAPP
  PUSH
}

enum CommunicationProvider {
  SMTP
  GMAIL
  META
  EVOLUTION
  PUSH_PENDING
}

enum CommunicationDeliveryStatus {
  PENDING
  SENDING
  ACCEPTED
  DELIVERED
  READ
  RETRY
  FAILED
  UNSENDABLE
  UNCERTAIN
  SKIPPED
}

model GlobalCommunicationProvider {
  provider             CommunicationProvider @id
  scope                CommunicationScope    @default(GLOBAL)
  environment          GatewayEnvironment    @default(SANDBOX)
  enabled              Boolean               @default(false)
  config               Json
  credentialsEncrypted String?
  status               IntegrationStatus     @default(NOT_CONFIGURED)
  revision             Int                   @default(1)
  lastVerifiedAt       DateTime?
  lastTestRecipient    String?
  lastTestStatus       String?
  lastSentAt           DateTime?
  lastError            String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

// One global event/channel policy and its channel-specific content; no redundant template parent.
model GlobalCommunicationTemplate {
  id        String                @id @default(uuid()) @db.Uuid
  scope     CommunicationScope    @default(GLOBAL)
  event     String
  channel   CommunicationChannel
  provider  CommunicationProvider
  enabled   Boolean               @default(false)
  content   Json
  revision  Int                   @default(1)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([event, channel])
}

// Optional per-company overrides. Missing rows inherit the GLOBAL template.
model CompanyCommunicationTemplate {
  id        String               @id @default(uuid()) @db.Uuid
  companyId String               @db.Uuid
  company   Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  event     String
  channel   CommunicationChannel
  enabled   Boolean              @default(true)
  content   Json
  revision  Int                  @default(1)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([companyId, event, channel])
  @@index([event, channel])
}

model GlobalCommunicationOutbox {
  id                      String                        @id @default(uuid()) @db.Uuid
  scope                   CommunicationScope            @default(GLOBAL)
  event                   String
  businessKey             String                        @unique
  companyId               String?                       @db.Uuid
  userId                  String?                       @db.Uuid
  variables               Json
  lastError               String?
  notificationProcessedAt DateTime?
  expandedAt              DateTime?
  createdAt               DateTime                      @default(now())
  deliveries              GlobalCommunicationDelivery[]

  @@index([notificationProcessedAt, createdAt])
  @@index([expandedAt, createdAt])
}

model GlobalCommunicationDelivery {
  id                    String                      @id @default(uuid()) @db.Uuid
  scope                 CommunicationScope          @default(GLOBAL)
  templateScope         CommunicationScope          @default(GLOBAL)
  outboxId              String                      @db.Uuid
  outbox                GlobalCommunicationOutbox   @relation(fields: [outboxId], references: [id])
  userId                String                      @db.Uuid
  targetKey             String                      @default("USER")
  channel               CommunicationChannel
  provider              CommunicationProvider
  environment           GatewayEnvironment
  configurationRevision Int
  templateId            String                      @db.Uuid
  templateRevision      Int
  recipientMasked       String
  payloadEncrypted      String?
  status                CommunicationDeliveryStatus @default(PENDING)
  attempts              Int                         @default(0)
  nextAttemptAt         DateTime                    @default(now())
  startedAt             DateTime?
  providerMessageId     String?
  lastError             String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  logs                  GlobalCommunicationLog[]

  @@unique([outboxId, userId, channel, targetKey], map: "GlobalCommunicationDelivery_target_key")
  @@index([status, nextAttemptAt])
  @@index([provider, environment, providerMessageId])
}

// Independent GLOBAL storage. No tenant credential or subscription can enter this table.
model GlobalGmailOAuthState {
  stateHash             String    @id @db.Char(64)
  bindingHash           String    @db.Char(64)
  codeVerifierEncrypted String
  actorId               String    @db.Uuid
  sessionId             String    @db.Uuid
  configurationRevision Int
  redirectUri           String
  expiresAt             DateTime
  usedAt                DateTime?
  createdAt             DateTime  @default(now())

  @@index([expiresAt])
}

enum GlobalPushPlatform {
  WEB
  ANDROID
  IOS
}

model GlobalPushSubscription {
  id                   String                    @id @default(uuid()) @db.Uuid
  scope                CommunicationScope        @default(GLOBAL)
  userId               String                    @db.Uuid
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // WEB_PUSH is implemented; NATIVE_PUSH is reserved and rejected until a native adapter exists.
  provider             String                    @default("WEB_PUSH")
  platform             GlobalPushPlatform        @default(WEB)
  environment          GatewayEnvironment        @default(SANDBOX)
  endpointHash         String                    @unique @db.Char(64)
  // Web endpoint/keys or a future native token; always encrypted with per-device AAD.
  credentialsEncrypted String?
  vapidPublicKey       String
  label                String?
  active               Boolean                   @default(true)
  expiresAt            DateTime?
  revokedAt            DateTime?
  lastSeenAt           DateTime                  @default(now())
  lastUsedAt           DateTime?
  authorizations       GlobalPushAuthorization[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@unique([id, userId])
  @@index([userId, active])
  @@index([active, expiresAt])
}

// Tenant consent for a GLOBAL-owned device; never a tenant provider configuration.
// Composite foreign keys guarantee that device owner and membership user match.
model GlobalPushAuthorization {
  subscriptionId String                 @db.Uuid
  userId         String                 @db.Uuid
  companyId      String                 @db.Uuid
  subscription   GlobalPushSubscription @relation(fields: [subscriptionId, userId], references: [id, userId], onDelete: Cascade)
  membership     Membership             @relation(fields: [userId, companyId], references: [userId, companyId], onDelete: Cascade)
  active         Boolean                @default(true)
  revokedAt      DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@id([subscriptionId, companyId])
  @@index([userId, companyId, active])
}

model GlobalCommunicationLog {
  id         String                       @id @default(uuid()) @db.Uuid
  scope      CommunicationScope           @default(GLOBAL)
  deliveryId String?                      @db.Uuid
  delivery   GlobalCommunicationDelivery? @relation(fields: [deliveryId], references: [id])
  outboxId   String?                      @db.Uuid
  actorId    String?                      @db.Uuid
  action     String
  code       String?
  attempt    Int?
  createdAt  DateTime                     @default(now())

  @@index([createdAt])
}

// Remote status is never administratively writable or inferred from submission.
model GlobalCommunicationMetaTemplate {
  id                String             @id @default(uuid()) @db.Uuid
  scope             CommunicationScope @default(GLOBAL)
  environment       GatewayEnvironment
  businessAccountId String
  externalId        String
  name              String
  language          String
  category          String
  status            String
  components        Json
  syncedAt          DateTime           @default(now())

  @@unique([environment, businessAccountId, externalId])
}

// Inbox history is independent of communication delivery channels and provider settings.
model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String?   @db.Uuid
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceKey   String
  type        String
  title       String
  message     String
  actionUrl   String?
  actionLabel String?
  createdAt   DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  expiresAt   DateTime  @default(dbgenerated())
  readAt      DateTime?

  @@unique([userId, sourceKey])
  @@index([userId, companyId, readAt, createdAt, id])
  @@index([expiresAt])
}

model NotificationPreference {
  userId          String   @id @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inSystemEnabled Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

// Tenant SMTP never references global credentials or delivery history.
model CompanyEmailConfiguration {
  companyId            String            @id @db.Uuid
  company              Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  config               Json
  credentialsEncrypted String?
  enabled              Boolean           @default(false)
  status               IntegrationStatus @default(NOT_CONFIGURED)
  revision             Int               @default(1)
  lastVerifiedAt       DateTime?
  lastTestRecipient    String?
  lastTestStatus       String?
  lastError            String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

enum EvolutionConnectionStatus {
  CREATED
  DELETING
  PENDING
  CREATING
