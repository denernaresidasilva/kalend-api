generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  RECEPTIONIST
  PROFESSIONAL
  CLIENT
}

enum CompanyStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELED
}

enum SubscriptionStatus {
  PENDING
  SUSPENDED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  OVERDUE
  PENDING
  APPROVED
  FAILED
  REFUNDED
  CANCELED
}

enum PaymentGateway {
  MANUAL
  MERCADO_PAGO
  STRIPE
  PAGBANK
  ASAAS
}

enum PaymentCreationState {
  READY
  CREATING
  CREATED
  UNCERTAIN
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  passwordHash String
  name         String
  phone        String?
  isActive     Boolean @default(true)
  isSuperAdmin Boolean @default(false)

  memberships             Membership[]
  authSessions            AuthSession[]
  globalPushSubscriptions GlobalPushSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id       String        @id @default(uuid()) @db.Uuid
  name     String
  slug     String        @unique
  status   CompanyStatus @default(TRIAL)
  timezone String        @default("America/Sao_Paulo")
  isActive Boolean       @default(true)

  memberships   Membership[]
  subscriptions Subscription[]
  payments      Payment[]
  webhookEvents WebhookEvent[]
  authSessions  AuthSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  companyId String         @db.Uuid
  role      MembershipRole
  isActive  Boolean        @default(true)

  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company            Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pushAuthorizations GlobalPushAuthorization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyId])
  @@index([companyId, role])
  @@index([userId])
}

model Plan {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  code        String  @unique
  description String?

  monthlyPriceCents Int
  yearlyPriceCents  Int?

  trialEnabled Boolean @default(true)
  trialDays    Int     @default(7)

  badge        String?
  isFeatured   Boolean @default(false)
  displayOrder Int     @default(0)

  maxProfessionals Int?
  maxClients       Int?
  maxUnits         Int? @default(1)

  isActive    Boolean @default(true)
  isPublic    Boolean @default(true)
  maxMessages Int?

  features      PlanFeature[]
  subscriptions Subscription[]
  payments      Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
}

model PlanFeature {
  id     String @id @default(uuid()) @db.Uuid
  planId String @db.Uuid

  code String
  name String

  enabled Boolean @default(true)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, code])
  @@index([planId])
}

model Subscription {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  planId    String @db.Uuid

  status          SubscriptionStatus @default(TRIALING)
  billingInterval BillingInterval    @default(MONTHLY)

  trialStartedAt DateTime?
  trialEndsAt    DateTime?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  canceledAt DateTime?
  endedAt    DateTime?

  gateway PaymentGateway @default(MANUAL)

  environment             GatewayEnvironment?
  expectedAmountCents     Int?
  currency                String              @default("BRL")
  graceEndsAt             DateTime?
  cancelAtPeriodEnd       Boolean             @default(false)
  cancellationRequestedAt DateTime?
  externalSubscriptionId  String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gateway, environment, externalSubscriptionId])
  @@index([companyId])
  @@index([planId])
  @@index([status])
  @@index([externalSubscriptionId])
}

model Payment {
  id             String  @id @default(uuid()) @db.Uuid
  companyId      String  @db.Uuid
  subscriptionId String? @db.Uuid

  billingInterval     BillingInterval      @default(MONTHLY)
  externalCheckoutId  String?
  checkoutUrl         String?
  creationState       PaymentCreationState @default(READY)
  creationStartedAt   DateTime?
  recurring           Boolean              @default(false)
  refundedAmountCents Int                  @default(0)
  amountCents         Int
  status              PaymentStatus
  gateway             PaymentGateway

  planId            String?             @db.Uuid
  plan              Plan?               @relation(fields: [planId], references: [id])
  environment       GatewayEnvironment?
  idempotencyKey    String?             @unique
  currency          String              @default("BRL")
  periodStart       DateTime?
  periodEnd         DateTime?
  webhookEvents     WebhookEvent[]
  externalPaymentId String?
  description       String?

  paidAt     DateTime?
  refundedAt DateTime?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gateway, environment, externalPaymentId])
  @@index([companyId])
  @@index([subscriptionId])
  @@index([status])
  @@index([gateway])
  @@index([externalPaymentId])
}

model WebhookEvent {
  id String @id @default(uuid()) @db.Uuid

  gateway PaymentGateway

  externalEventId String
  eventType       String?

  companyId   String?             @db.Uuid
  paymentId   String?             @db.Uuid
  company     Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  payment     Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  environment GatewayEnvironment?
  attempts    Int                 @default(0)
  payload     Json

  status       WebhookStatus @default(RECEIVED)
  errorMessage String?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gateway, environment, externalEventId])
  @@index([gateway])
  @@index([status])
  @@index([receivedAt])
}

enum GatewayEnvironment {
  SANDBOX
  PRODUCTION
}

enum IntegrationStatus {
  NOT_CONFIGURED
  PENDING_VALIDATION
  CONNECTED
  FAILED
}

model GatewayConfiguration {
  gateway                       PaymentGateway     @id
  enabled                       Boolean            @default(false)
  environment                   GatewayEnvironment @default(SANDBOX)
  publicId                      String?
  credentialsEncrypted          String?
  recurringCredentialsEncrypted String?
  recurringEnabled              Boolean            @default(false)
  webhookSecretEncrypted        String?
  status                        IntegrationStatus  @default(NOT_CONFIGURED)
  lastValidatedAt               DateTime?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
}

model AuthSession {
  credentialHash    String             @db.Char(64)
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @db.Uuid
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedCompanyId String?            @db.Uuid
  selectedCompany   Company?           @relation(fields: [selectedCompanyId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  lastUsedAt        DateTime           @default(now())
  expiresAt         DateTime
  refreshExpiresAt  DateTime
  revokedAt         DateTime?
  refreshTokens     AuthRefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuthRefreshToken {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @db.Uuid
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash String      @unique @db.Char(64)
  createdAt DateTime    @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([sessionId])
  @@index([expiresAt])
}

model AuthRateLimit {
  key       String   @id @db.Char(64)
  attempts  Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

enum CommunicationScope {
  GLOBAL
}

enum CommunicationChannel {
  EMAIL
  WHATSAPP
  PUSH
}

enum CommunicationProvider {
  SMTP
  GMAIL
  META
  EVOLUTION
  PUSH_PENDING
}

enum CommunicationDeliveryStatus {
  PENDING
  SENDING
  ACCEPTED
  DELIVERED
  READ
  RETRY
  FAILED
  UNSENDABLE
  UNCERTAIN
  SKIPPED
}

model GlobalCommunicationProvider {
  provider             CommunicationProvider @id
  scope                CommunicationScope    @default(GLOBAL)
  environment          GatewayEnvironment    @default(SANDBOX)
  enabled              Boolean               @default(false)
  config               Json
  credentialsEncrypted String?
  status               IntegrationStatus     @default(NOT_CONFIGURED)
  revision             Int                   @default(1)
  lastVerifiedAt       DateTime?
  lastSentAt           DateTime?
  lastError            String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

// One global event/channel policy and its channel-specific content; no redundant template parent.
model GlobalCommunicationTemplate {
  id        String                @id @default(uuid()) @db.Uuid
  scope     CommunicationScope    @default(GLOBAL)
  event     String
  channel   CommunicationChannel
  provider  CommunicationProvider
  enabled   Boolean               @default(false)
  content   Json
  revision  Int                   @default(1)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([event, channel])
}

model GlobalCommunicationOutbox {
  id          String                        @id @default(uuid()) @db.Uuid
  scope       CommunicationScope            @default(GLOBAL)
  event       String
  businessKey String                        @unique
  companyId   String?                       @db.Uuid
  userId      String?                       @db.Uuid
  variables   Json
  lastError   String?
  expandedAt  DateTime?
  createdAt   DateTime                      @default(now())
  deliveries  GlobalCommunicationDelivery[]

  @@index([expandedAt, createdAt])
}

model GlobalCommunicationDelivery {
  id                    String                      @id @default(uuid()) @db.Uuid
  scope                 CommunicationScope          @default(GLOBAL)
  outboxId              String                      @db.Uuid
  outbox                GlobalCommunicationOutbox   @relation(fields: [outboxId], references: [id])
  userId                String                      @db.Uuid
  targetKey             String                      @default("USER")
  channel               CommunicationChannel
  provider              CommunicationProvider
  environment           GatewayEnvironment
  configurationRevision Int
  templateId            String                      @db.Uuid
  templateRevision      Int
  recipientMasked       String
  payloadEncrypted      String?
  status                CommunicationDeliveryStatus @default(PENDING)
  attempts              Int                         @default(0)
  nextAttemptAt         DateTime                    @default(now())
  startedAt             DateTime?
  providerMessageId     String?
  lastError             String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  logs                  GlobalCommunicationLog[]

  @@unique([outboxId, userId, channel, targetKey], map: "GlobalCommunicationDelivery_target_key")
  @@index([status, nextAttemptAt])
  @@index([provider, environment, providerMessageId])
}

// Independent GLOBAL storage. No tenant credential or subscription can enter this table.
model GlobalGmailOAuthState {
  stateHash             String    @id @db.Char(64)
  bindingHash           String    @db.Char(64)
  codeVerifierEncrypted String
  actorId               String    @db.Uuid
  sessionId             String    @db.Uuid
  configurationRevision Int
  redirectUri           String
  expiresAt             DateTime
  usedAt                DateTime?
  createdAt             DateTime  @default(now())

  @@index([expiresAt])
}

enum GlobalPushPlatform {
  WEB
  ANDROID
  IOS
}

model GlobalPushSubscription {
  id                   String                    @id @default(uuid()) @db.Uuid
  scope                CommunicationScope        @default(GLOBAL)
  userId               String                    @db.Uuid
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // WEB_PUSH is implemented; NATIVE_PUSH is reserved and rejected until a native adapter exists.
  provider             String                    @default("WEB_PUSH")
  platform             GlobalPushPlatform        @default(WEB)
  environment          GatewayEnvironment        @default(SANDBOX)
  endpointHash         String                    @unique @db.Char(64)
  // Web endpoint/keys or a future native token; always encrypted with per-device AAD.
  credentialsEncrypted String?
  vapidPublicKey       String
  label                String?
  active               Boolean                   @default(true)
  expiresAt            DateTime?
  revokedAt            DateTime?
  lastSeenAt           DateTime                  @default(now())
  lastUsedAt           DateTime?
  authorizations       GlobalPushAuthorization[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@unique([id, userId])
  @@index([userId, active])
  @@index([active, expiresAt])
}

// Tenant consent for a GLOBAL-owned device; never a tenant provider configuration.
// Composite foreign keys guarantee that device owner and membership user match.
model GlobalPushAuthorization {
  subscriptionId String                 @db.Uuid
  userId         String                 @db.Uuid
  companyId      String                 @db.Uuid
  subscription   GlobalPushSubscription @relation(fields: [subscriptionId, userId], references: [id, userId], onDelete: Cascade)
  membership     Membership             @relation(fields: [userId, companyId], references: [userId, companyId], onDelete: Cascade)
  active         Boolean                @default(true)
  revokedAt      DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@id([subscriptionId, companyId])
  @@index([userId, companyId, active])
}

model GlobalCommunicationLog {
  id         String                       @id @default(uuid()) @db.Uuid
  scope      CommunicationScope           @default(GLOBAL)
  deliveryId String?                      @db.Uuid
  delivery   GlobalCommunicationDelivery? @relation(fields: [deliveryId], references: [id])
  outboxId   String?                      @db.Uuid
  actorId    String?                      @db.Uuid
  action     String
  code       String?
  attempt    Int?
  createdAt  DateTime                     @default(now())

  @@index([createdAt])
}

// Remote status is never administratively writable or inferred from submission.
model GlobalCommunicationMetaTemplate {
  id                String             @id @default(uuid()) @db.Uuid
  scope             CommunicationScope @default(GLOBAL)
  environment       GatewayEnvironment
  businessAccountId String
  externalId        String
  name              String
  language          String
  category          String
  status            String
  components        Json
  syncedAt          DateTime           @default(now())

  @@unique([environment, businessAccountId, externalId])
}
