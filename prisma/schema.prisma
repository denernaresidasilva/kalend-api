model EvolutionConnection {
  // Optimistic concurrency: callbacks never wait for the remote-operation lease.
  version                Int @default(0)
  codeEncrypted          String?
  pairingPhoneEncrypted  String?
  attemptStartedAt       DateTime?
  attemptExpiresAt       DateTime?
  lastConnectionEventAt  DateTime?
  disconnectReason       Int?
  provisionRequested     Boolean @default(false)
  provisionRetryAt       DateTime?
  environment            EvolutionEnvironment?
  connectionRequested    Boolean @default(false)
  codeFingerprint        String?
  codeExpiresAt          DateTime?
  lastRecoveryAt         DateTime?
  id                     String @id @default(uuid()) @db.Uuid
  companyId              String? @unique @db.Uuid
  company                Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  globalKey              String? @unique
  instanceName           String @unique
  status                 EvolutionConnectionStatus @default(PENDING)
  prepared               Boolean @default(false)
  pairingMethod          String @default("QR")
  phone                  String?
  profileName            String?
  connectedAt            DateTime?
  disconnectedAt         DateTime?
  lastSeenAt             DateTime?
  lastQrAt               DateTime?
  lastError              String?
  webhookSecretEncrypted String?
  lastWebhookAt          DateTime?
  leaseId                String? @db.Uuid
  leaseExpiresAt         DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  @@index([codeExpiresAt])
  @@index([attemptExpiresAt])
  @@index([provisionRequested, provisionRetryAt])
}

// A persisted, auditable right. Payment evidence remains subject to financial reversal.
